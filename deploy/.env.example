# Копия в deploy/.env на сервере. Сам .env не коммитится.

# Токен бота от @BotFather
BOT_TOKEN=

# Ключи ИИ-провайдеров
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Логи и часовой пояс
LOG_LEVEL=info
TZ=Asia/Almaty

# Локальный порт, на который пробрасывается healthcheck (внутри контейнера всегда 8080)
BOT_PORT=8081
