# Copy this file to deploy/.env on the server and fill in the values.
# deploy/.env is never committed.

# --- Telegram ---------------------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma separated Telegram user ids that are allowed to use the bot
ALLOWED_TELEGRAM_ID=

# --- Obsidian vault ---------------------------------------------------------
# Path of the vault on the host. The same folder is shared with Syncthing.
VAULT_HOST_PATH=/opt/obsidian-vault
# Inside the container the vault is always mounted at /vault.
OBSIDIAN_VAULT_PATH=/vault
TIMEZONE=Asia/Almaty

# --- Model provider ---------------------------------------------------------
# The OpenCode Go relay. The key is injected by the local proxy, the agent
# only talks to http://127.0.0.1:11434/v1 inside the container.
LLM_PROVIDER_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
LLM_PROXY_PORT=11434

# --- Hermes Agent -----------------------------------------------------------
HERMES_MODEL=minimax-m3.1-flash-free
HERMES_FALLBACK_MODEL=deepseek-v4.1-flash
HERMES_TIMEOUT_MS=300000
HERMES_MAX_TURNS=16

# --- Syncthing --------------------------------------------------------------
# The user id of the owner of the notes, the same as in the app container.
PUID=1000
PGID=1000
TZ=Asia/Almaty

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=info
BOT_ACK=⏳ Записываю в Obsidian...
